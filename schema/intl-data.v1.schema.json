{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finlex-site/schema/intl-data.v1.schema.json",
  "title": "FinLex International & US Standards Pack Schema (v1)",
  "description": "Schema contract for public compliant international (INTL) and United States (US) standards JSON packs under intl_data/ (excluding home_news.json).",
  "type": "object",
  "required": ["documents"],
  "properties": {
    "schema_version": { "type": "string" },
    "framework": { "type": "string", "enum": ["INTL", "US"] },
    "domain": { "type": "string", "enum": ["accounting", "audit", "tax", "general"] },
    "generated_at": { "type": "string" },
    "collected_at": { "type": "string" },
    "source": { "type": "string" },
    "source_policy": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "document_count": { "type": "integer", "minimum": 0 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "framework",
          "domain",
          "doc_type",
          "title",
          "display_title",
          "series_badge",
          "doc_no",
          "issuer",
          "pub_date",
          "effective_date",
          "status",
          "version_level",
          "version_note",
          "source_name",
          "source_url",
          "source_kind",
          "summary",
          "cited_codes",
          "cas_links",
          "articles"
        ],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "slug": { "type": "string" },
          "framework": { "type": "string", "enum": ["INTL", "US"] },
          "domain": { "type": "string", "enum": ["accounting", "audit", "tax", "general"] },
          "doc_type": {
            "type": "string",
            "enum": ["law", "regulation", "standard", "rule", "guidance", "normative", "interpretation", "case"]
          },
          "title": { "type": "string", "minLength": 1 },
          "display_title": { "type": "string", "minLength": 1 },
          "series_badge": { "type": "string" },
          "doc_no": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "pub_date": { "type": "string" },
          "effective_date": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["in_force", "will_replace", "upcoming", "outdated", "pending"]
          },
          "version_level": { "type": "string" },
          "version_note": { "type": "string" },
          "replaced_by_code": { "type": ["string", "null"] },
          "source_name": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "pattern": "^https?://" },
          "source_kind": { "type": "string", "enum": ["official", "third_party", "official_pending", "user_submitted"] },
          "summary": { "type": "string", "minLength": 1 },
          "cited_codes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "cas_links": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "ifrs_links": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "articles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["no", "heading", "text", "seq"],
              "properties": {
                "no": { "type": "string", "minLength": 1 },
                "heading": { "type": "string" },
                "text": { "type": "string", "minLength": 1 },
                "seq": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
